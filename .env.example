# DreamTale 环境变量示例
# 复制为 .env 并按需修改

# 数据库路径（默认 data/dreamtale.db，部署到 ModelScope 时设为 /mnt/workspace/data/dreamtale.db）
DREAMTALE_DB=data/dreamtale.db

# 服务端口（ModelScope 固定 7860）
PORT=7860

# ===== AI 增强层（Phase 2 实现，Phase 1 仅占位）=====
# 配置以下任一 API key 后激活 AI 功能；留空则纯手工模式

# OpenAI 兼容接口（支持 OpenAI / 通义 / DeepSeek / Moonshot 等）
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude
# ANTHROPIC_API_KEY=

# ===== 热点采集（Phase 4 实现，Phase 1 仅占位）=====
# 知乎/微博/抖音/番茄/红果/小红书 等平台 cookie 或 API token
# ZHIHU_COOKIE=
# WEIBO_COOKIE=
